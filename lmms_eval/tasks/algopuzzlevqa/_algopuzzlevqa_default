dataset_path: declare-lab/AlgoPuzzleVQA
dataset_kwargs:
  token: True

test_split: data
output_type: generate_until
doc_to_visual: !function utils.algopuzzlevqa_doc_to_visual
doc_to_text: !function utils.algopuzzlevqa_doc_to_text
doc_to_target: "answer"
generation_kwargs:
  max_new_tokens: 128

process_results: !function utils.algopuzzlevqa_process_results
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true

lmms_eval_specific_kwargs:
  default:
    pre_prompt: ""
    post_prompt: "\nAnswer with the option's letter from the given choices directly."
  qwen3_vl:
    pre_prompt: "Question: "
    post_prompt: "\nAnswer with the option letter only."

metadata:
  - version: 0.0
